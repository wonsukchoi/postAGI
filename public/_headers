# Cloudflare reads this file. Security headers go on every response.
# The site is a static export, so pages carry inline scripts (Next's page data and
# the JSON-LD blocks) and a build cannot add per-request nonces: script-src needs
# 'unsafe-inline'. The only outside host is the Umami script and its beacon.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://analytics.wonsukchoi.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://analytics.wonsukchoi.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# The generated preview images have no file
# extension, so tell browsers and social sites what they are.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400

/occupations/*/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400
